[Unit]
Description=Back up the TPV karaoke catalog using its dedicated read-only database account
After=mysql.service
Requires=mysql.service
ConditionPathExists=/etc/tpv-karaoke-catalog/managed.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/tpv-karaoke-catalog/backup-catalog.sh production
TimeoutStartSec=10min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/tpv-karaoke-catalog/production /run/lock/tpv-karaoke-catalog
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=256
TasksMax=32
MemoryMax=512M
