[Unit]
Description=TPV authenticated read-only karaoke catalog
After=mysql.service
Requires=mysql.service
ConditionPathExists=/etc/tpv-karaoke-catalog/managed.json

[Service]
Type=simple
DynamicUser=yes
User=tpv-catalog-reader
Group=tpv-catalog-reader
UMask=0077
RuntimeDirectory=tpv-karaoke-catalog-reader
RuntimeDirectoryMode=0700
WorkingDirectory=/opt/tpv-karaoke-catalog
EnvironmentFile=/etc/tpv-karaoke-catalog/production.env
Environment=TPV_KN_MYSQL_USER=tpv_kn_reader
Environment=TPV_KN_SERVICE_PORT=8765
Environment=TPV_KN_MYSQL_PASSWORD_FILE=/run/tpv-karaoke-catalog-reader/mysql.password
Environment=TPV_KN_SERVICE_TOKEN_FILE=/run/tpv-karaoke-catalog-reader/service.token
LoadCredential=mysql.password:/etc/tpv-karaoke-catalog/reader.password
LoadCredential=service.token:/etc/tpv-karaoke-catalog/service.token
# systemd credential mounts can use 0440; the app requires owner-only files.
ExecStartPre=/usr/bin/install -m0400 %d/mysql.password /run/tpv-karaoke-catalog-reader/mysql.password
ExecStartPre=/usr/bin/install -m0400 %d/service.token /run/tpv-karaoke-catalog-reader/service.token
ExecStart=/opt/tpv-karaoke-catalog/node /opt/tpv-karaoke-catalog/catalog-service.cjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=256
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=multi-user.target
