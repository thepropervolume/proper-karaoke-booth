[Unit]
Description=Back up TPV relay lease metadata
After=mysql.service
Requires=mysql.service
ConditionPathExists=/etc/tpv-queue-relay/db-managed.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/tpv-queue-relay/backup-leases.sh
TimeoutStartSec=10min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/tpv-queue-relay /run/lock/tpv-queue-relay
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=64
TasksMax=8
MemoryMax=512M
