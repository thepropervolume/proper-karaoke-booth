{
  "name": "proper-karaoke-booth",
  "version": "0.10.14",
  "private": true,
  "description": "Local-first karaoke host and singer display",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "npm run typecheck && npm run build:assets && npm run build:electron",
    "build:assets": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:ci": "tsx --test --test-concurrency=4 tests/**/*.test.ts",
    "test:release": "node --test tests/releasing/*.test.mjs",
    "start": "electron .",
    "package:win": "npm run typecheck && node scripts/package-app.mjs win",
    "package:linux": "npm run typecheck && node scripts/package-app.mjs linux",
    "package:mac": "npm run typecheck && node scripts/package-app.mjs mac",
    "build:mobile": "node scripts/build-mobile.mjs",
    "dev:mobile": "vite --config vite.mobile.config.mts"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@fontsource/nunito-sans": "^5.3.0",
    "@ionic/react": "9.0.13",
    "@peculiar/asn1-schema": "3.0.0",
    "@peculiar/x509": "3.1.0",
    "@thepropervolume/karaoke-core": "file:vendor/thepropervolume-karaoke-core-0.1.2.tgz",
    "ionicons": "8.1.1",
    "multicast-dns": "7.2.5",
    "mysql2": "^3.24.6",
    "parse5": "^7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "0.2.2",
    "saxes": "6.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/multicast-dns": "7.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.4.0",
    "electron": "^45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "marked": "18.2.1",
    "playwright-core": "^1.65.0",
    "sass": "^1.108.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "author": {
    "name": "The Proper Volume"
  },
  "homepage": "https://thepropervolume.com"
}
