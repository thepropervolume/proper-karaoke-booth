{
  "name": "proper-karaoke-booth",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first karaoke host and singer display",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "npm run typecheck && npm run build:assets && npm run build:electron",
    "build:assets": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "sass": "^1.108.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
